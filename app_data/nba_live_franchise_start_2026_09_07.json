  "profile_methodology": "Source-informed simulation profiles for real players absent from the older 2026-27 runtime. Eight overall ratings use released current 2KRatings anchors. The other 11 have no released current roster rating and therefore use a separately labeled empirical lower-roster calibration from their retained production, competition level, sample size, position, and the current 2K roster distribution. All 19 production, shooting-efficiency, broader-skill, potential, and future-outlook profiles retain evidence and deterministic translation metadata.",
  "profile_evidence_sources": {
    "current_2kratings_snapshot_v1": {"label": "2KRatings current NBA 2K27 snapshot", "captured_at_utc": "2026-09-10T01:28:40.8277621Z", "source_url": "https://www.2kratings.com/current-teams", "independent_fan_site": true, "released_player_count": 649, "distribution_anchors": {"minimum_non_outlier": 67, "p05": 68, "p20": 70, "median": 74}, "scope": "Released overall, listed position, and archetype where present. A fresh 31-page team/free-agent scrape found no released rows for the 11 empirical-proxy players."}
  },
  "rating_profile_methodology": {
    "version": "live-supplemental-rating-profile-translation-v1-2026-09-09",
    "method": "Released current 2K overall ratings are retained exactly for eight players. For the 11 absent from the released roster dataset, a 68-point lower-roster anchor is adjusted by source/sample-weighted scoring, rebounding, playmaking, defense, and ball-security evidence, rounded to half points, and bounded to the released lower-roster range. Potential and future outlook are deterministic age-curve projections from the resolved overall plus the same evidence signal.",
    "unreleased_rating_status": "source_informed_empirical_proxy_no_released_game_rating",
    "scope_note": "Empirical proxies are not represented as official or released 2K ratings. Direct ratings and empirical proxies remain separately countable in the live universe."
  },
  "skill_profile_methodology": {
    "version": "live-supplemental-skill-profile-translation-v1-2026-09-09",
    "method": "Scoring, shooting, playmaking, rebounding, defense, efficiency, and availability ratings are differentiated from the resolved overall using competition-adjusted production, sample-adjusted shooting targets, positional priors, source reliability, and age. The exact installed skills and source metadata remain attached to each player.",
    "scope_note": "These are simulator calibration ratings, not claims that a third-party game released detailed attributes for the supplemental players."
  },
  "statistical_profile_methodology": {
    "version": "live-supplemental-stat-profile-translation-v1-2026-09-09",
    "method": "Observed per-36 production is blended toward the existing simulator's position priors. NBA samples receive the strongest weight; NCAA, G League, and international samples receive smaller weights based on competition and games played. Raw observations, source level, season, sample, and URL remain attached to each player.",
    "translation_context_url": "https://journals.sagepub.com/doi/10.1177/22150218261428808",
    "scope_note": "The translation is a conservative simulator calibration, not a claim that source-league production is directly NBA-equivalent. Shooting percentages are separately sample-adjusted from published attempt volume; broader skill ratings and future potential remain modeled."
  },
  "shooting_profile_methodology": {
    "version": "live-supplemental-shooting-profile-translation-v1-2026-09-09",
    "method": "Published field-goal, three-point, and free-throw percentages are shrunk toward the simulator's position and overall priors according to source competition and relevant attempt volume. Two-point percentage is reconstructed from field-goal and three-point makes/attempts. The installed target then moves with later scoring, shooting, and efficiency development instead of remaining frozen.",
    "gleague_attempt_note": "The official G League profile table publishes rounded per-game lines; its attempt samples are therefore transparent estimates from games played times the published per-game attempts. Those smaller samples receive conservative shrinkage."
  },
